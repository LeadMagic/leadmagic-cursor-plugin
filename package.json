{
  "name": "leadmagic-cursor-plugin",
  "private": true,
  "version": "0.1.9",
  "engines": {
    "node": ">=22"
  },
  "description": "Submission package for the LeadMagic Cursor plugin",
  "license": "MIT",
  "scripts": {
